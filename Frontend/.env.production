# Production env — set REACT_APP_API_URL to your Cloud Run service URL
# After deploying the backend, get the URL with:
#   gcloud run services describe stocktime-api --region=us-central1 --format='value(status.url)'
# Then paste it here:
REACT_APP_API_URL=https://stocktime-api-XXXXXXXXXX-uc.a.run.app
