# ================================
# Node.js / JavaScript / React
# ================================

# Dependencies
node_modules/
Frontend/node_modules/
**/node_modules/

# Build output
Frontend/build/
dist/
.next/
out/

# Package manager files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
Frontend/.env
Frontend/.env.local

# Cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

