# =============================================================================
# LSTM SERVICE - Dockerfile for Google Cloud Run
# =============================================================================
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies for TensorFlow
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    libhdf5-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy and install requirements
COPY services/model_lstm/requirements.cloud.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY utils/ ./utils/
COPY services/model_lstm/ ./services/model_lstm/

# Create models directory
RUN mkdir -p /app/models/lstm

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV LOCAL_MODEL_DIR=/app/models
ENV TF_CPP_MIN_LOG_LEVEL=2

# Expose port
EXPOSE 8002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8002/health || exit 1

# Run with extended timeout for training
CMD ["sh", "-c", "gunicorn services.model_lstm.main_cloud:app --bind :${PORT:-8002} --workers 1 --worker-class uvicorn.workers.UvicornWorker --timeout 900 --keep-alive 120 --access-logfile - --error-logfile -"]
