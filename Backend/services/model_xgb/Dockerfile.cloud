# =============================================================================
# XGBoost SERVICE - Dockerfile for Google Cloud Run
# =============================================================================
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install requirements
COPY services/model_xgb/requirements.cloud.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY utils/ ./utils/
COPY services/model_xgb/ ./services/model_xgb/

# Create models directory
RUN mkdir -p /app/models/xgb

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV LOCAL_MODEL_DIR=/app/models

# Expose port
EXPOSE 8003

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8003/health || exit 1

# Run with extended timeout for training
CMD ["sh", "-c", "gunicorn services.model_xgb.main_cloud:app --bind :${PORT:-8003} --workers 1 --worker-class uvicorn.workers.UvicornWorker --timeout 600 --keep-alive 120 --access-logfile - --error-logfile -"]
