# =============================================================================
# Ensemble MODEL SERVICE - Dockerfile for Google Cloud Run
# =============================================================================
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install requirements
COPY services/model_ensemble/requirements.cloud.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY services/model_ensemble/ ./services/model_ensemble/

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Expose port
EXPOSE 8006

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8006/health || exit 1

# Run service
CMD ["sh", "-c", "gunicorn services.model_ensemble.app_cloud:app --bind :${PORT:-8006} --workers 2 --worker-class uvicorn.workers.UvicornWorker --timeout 180 --keep-alive 60 --access-logfile - --error-logfile -"]
