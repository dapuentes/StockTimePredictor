# =============================================================================
# SHAP Explainer SERVICE - Dockerfile for Google Cloud Run
# =============================================================================
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install requirements
COPY services/shap_explainer/requirements.cloud.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY utils/ ./utils/
COPY services/shap_explainer/ ./services/shap_explainer/
COPY services/model_xgb/ ./services/model_xgb/
COPY services/model_rf/ ./services/model_rf/

# Create models directories
RUN mkdir -p /app/models/rf /app/models/xgb

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV LOCAL_MODEL_DIR=/app/models

# Expose port
EXPOSE 8005

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8005/health || exit 1

# Run service
CMD ["sh", "-c", "gunicorn services.shap_explainer.app_cloud:app --bind :${PORT:-8005} --workers 1 --worker-class uvicorn.workers.UvicornWorker --timeout 120 --keep-alive 60 --access-logfile - --error-logfile -"]
